#include<stdio.h>
#include<stdlib.h>

#define MAX 5

int deque[MAX];
int front=-1, rear=-1;

void insertFront()
{
    int item;

    if(front==0)
        printf("Overflow");
    else
    {
        printf("Enter element: ");
        scanf("%d",&item);

        if(front==-1)
        {
            front=0;
            rear=0;
        }
        else
            front=front-1;

        deque[front]=item;
    }
}

void insertRear()
{
    int item;

    if(rear==MAX-1)
        printf("Overflow");
    else
    {
        printf("Enter element: ");
        scanf("%d",&item);

        if(front==-1)
            front=0;

        rear=rear+1;
        deque[rear]=item;
    }
}

void deleteFront()
{
    if(front==-1)
        printf("Underflow");
    else
    {
        printf("Deleted element: %d",deque[front]);

        if(front==rear)
        {
            front=-1;
            rear=-1;
        }
        else
            front=front+1;
    }
}

void deleteRear()
{
    if(rear==-1)
        printf("Underflow");
    else
    {
        printf("Deleted element: %d",deque[rear]);

        if(front==rear)
        {
            front=-1;
            rear=-1;
        }
        else
            rear=rear-1;
    }
}

void display()
{
    int i;

    if(front==-1)
        printf("Empty");
    else
    {
        for(i=front;i<=rear;i=i+1)
            printf("%d ",deque[i]);
    }
}

void main()
{
    int ch;

    while(1)
    {
        printf("\n1.Insert Front\n2.Insert Rear");
        printf("\n3.Delete Front\n4.Delete Rear");
        printf("\n5.Display\n6.Exit");

        printf("\nEnter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1: insertFront();
                    break;

            case 2: insertRear();
                    break;

            case 3: deleteFront();
                    break;

            case 4: deleteRear();
                    break;

            case 5: display();
                    break;

            case 6: exit(0);
        }
    }
}
