#include<stdio.h>
#include<stdlib.h>

#define MAX 5

int cq[MAX];
int front=-1, rear=-1;

void enqueue()
{
    int item;

    if((rear+1)%MAX==front)
        printf("Overflow");
    else
    {
        printf("Enter element: ");
        scanf("%d",&item);

        if(front==-1)
        {
            front=0;
            rear=0;
        }
        else
            rear=(rear+1)%MAX;

        cq[rear]=item;
    }
}

void dequeue()
{
    if(front==-1)
        printf("Underflow");
    else
    {
        printf("Deleted element: %d",cq[front]);

        if(front==rear)
        {
            front=-1;
            rear=-1;
        }
        else
            front=(front+1)%MAX;
    }
}

void display()
{
    int i;

    if(front==-1)
        printf("Empty");
    else
    {
        i=front;

        while(1)
        {
            printf("%d ",cq[i]);

            if(i==rear)
                break;

            i=(i+1)%MAX;
        }
    }
}

void main()
{
    int ch;

    while(1)
    {
        printf("\n1.Enqueue\n2.Dequeue\n3.Display\n4.Exit");

        printf("\nEnter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1: enqueue();
                    break;

            case 2: dequeue();
                    break;

            case 3: display();
                    break;

            case 4: exit(0);
        }
    }
}
